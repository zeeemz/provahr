# PostgreSQL connection string.
# With the repo's docker-compose db: postgresql://postgres:postgres@localhost:5432/hiring_platform?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hiring_platform?schema=public

# Secret used to sign login tokens (JWT).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long login tokens stay valid.
JWT_EXPIRES_IN=12h

# Port the API listens on.
PORT=4000

# Comma-separated list of frontend origins allowed to call the API (or * to allow all).
CORS_ORIGIN=http://localhost:5173

# development | test | production
NODE_ENV=development

# ── Authentication mode ──────────────────────────────────────────────
# false = local dev mode (email/password, JWT signed with JWT_SECRET above)
# true  = Keycloak mode (OIDC). Org users authenticate against Keycloak;
#         companies can federate Azure AD / SAML / LDAP via Keycloak.
OIDC_ENABLED=false
OIDC_ISSUER_URL=http://localhost:8081/realms/provahr
OIDC_AUDIENCE=provahr-api

# ── Secret encryption ────────────────────────────────────────────────
# Encrypts LLM provider API keys at rest (AES-256-GCM). Losing or changing it
# invalidates every stored provider key — by design. See docs/SELF_HOSTING.md.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_KEY=dev-only-secrets-key-change-me

# How long the background worker (npm run dev:worker) sleeps between queue
# polls when idle, in milliseconds.
WORKER_POLL_MS=2000
